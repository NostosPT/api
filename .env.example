# This is an example environment file for the TypeScript API Template project.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# CORS_ORIGINS is a comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DATABASE_URL is the PostgreSQL connection string used by Prisma.
# Example only — never commit real credentials.
DATABASE_URL=postgresql://nostos:nostos@localhost:5432/nostos

# COOKIE_SECRET signs session-adjacent values (HMAC). Minimum 32 characters.
# Generate with `openssl rand -hex 32`. Never commit the real value.
COOKIE_SECRET=change-me-to-at-least-32-characters-long-secret

# TRUST_PROXY is empty for direct exposure, "true" behind a trusted proxy,
# or proxy IP(s) forwarded by the deployment (e.g. Caddy).
TRUST_PROXY=

# LOG_LEVEL overrides the default (debug locally, info in production).
LOG_LEVEL=

# DOCS_ENABLED defaults to true except in production.
DOCS_ENABLED=

# Session lifetimes (seconds) and concurrency cap. Defaults: 30d / 7d / 10.
SESSION_ABSOLUTE_SECONDS=
SESSION_IDLE_SECONDS=
SESSION_MAX_CONCURRENT=

# UPLOAD_MAX_BYTES caps presigned-upload intent sizes (default 50 MB).
# Photo bytes bypass the API via direct browser → storage uploads.
UPLOAD_MAX_BYTES=

# S3-compatible storage (SeaweedFS now, AWS later). All optional: the API boots
# without storage, and storage operations fail clearly when unconfigured.
# Only "s3" is supported as STORAGE_PROVIDER for now.
# The values below match the local SeaweedFS in compose.yml (`docker compose up -d`).
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=nostos
S3_ACCESS_KEY_ID=nostos-dev
S3_SECRET_ACCESS_KEY=nostos-dev-secret
# Browser-reachable endpoint used to sign presigned URLs. Leave empty when the
# API and the browser reach storage at the same address (local development).
S3_PUBLIC_ENDPOINT=
# Path-style bucket addressing, required by SeaweedFS/self-hosted S3.
S3_FORCE_PATH_STYLE=true

# --- Health monitoring (all server-only) ---------------------------------------
# Scheduled probes + check history + GET /v1/system/status. Defaults to true
# only when NODE_ENV=production.
MONITOR_ENABLED=
# Public base URL of this API as browsers reach it (through the proxy).
# Enables the PUBLIC_API and PUBLIC_API_TLS probes. Empty disables them.
MONITOR_PUBLIC_URL=
# true probes S3_PUBLIC_ENDPOINT (reachability + TLS). Requires S3_PUBLIC_ENDPOINT.
MONITOR_PUBLIC_STORAGE=false
# Days of check history and backup runs kept in PostgreSQL (default 30).
HEALTH_RETENTION_DAYS=
# Optional overrides (defaults in parentheses):
# MONITOR_INTERVAL_DATABASE_SECONDS (60), MONITOR_INTERVAL_STORAGE_SECONDS (60),
# MONITOR_INTERVAL_STORAGE_WRITE_SECONDS (3600), MONITOR_INTERVAL_PUBLIC_SECONDS (60),
# MONITOR_INTERVAL_TLS_SECONDS (21600), MONITOR_INTERVAL_BACKUP_SECONDS (900),
# MONITOR_FAILURE_THRESHOLD (3), MONITOR_RECOVERY_THRESHOLD (2),
# MONITOR_TIMEOUT_MS (5000), MONITOR_PUBLIC_TIMEOUT_MS (10000),
# MONITOR_DATABASE_SLOW_MS (500), MONITOR_STORAGE_SLOW_MS (1000),
# MONITOR_PUBLIC_SLOW_MS (2000), MONITOR_TLS_DEGRADED_DAYS (14),
# MONITOR_TLS_DOWN_DAYS (3), MONITOR_BACKUP_DEGRADED_HOURS (26),
# MONITOR_BACKUP_DOWN_HOURS (50).

# --- Alert emails (Resend, server-only) ----------------------------------------
# Alerts go to every ACTIVE ADMIN user. Alerting stays disabled (warning logged)
# until both RESEND_API_KEY and ALERT_EMAIL_FROM are set. Never commit the key.
RESEND_API_KEY=
# Verified Resend sender: "alerts@example.com" or "Nostos Alerts <alerts@example.com>".
ALERT_EMAIL_FROM=
# Comma-separated; used only when no ADMIN list has been cached yet (e.g. the
# API started while PostgreSQL was down).
ALERT_FALLBACK_RECIPIENTS=
