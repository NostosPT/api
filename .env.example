# Copy to .env for local development (`pnpm dev`) against `docker compose up -d postgres s3`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://nostos:nostos@localhost:5432/nostos

# Generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=30
# true in production (HTTPS only)
COOKIE_SECURE=false

# Local SeaweedFS from docker-compose. For AWS: remove S3_ENDPOINT, S3_PUBLIC_ENDPOINT
# and S3_FORCE_PATH_STYLE, and set real credentials/region/bucket.
S3_REGION=us-east-1
S3_BUCKET=nostos
S3_ACCESS_KEY_ID=nostos
S3_SECRET_ACCESS_KEY=nostos-dev-secret
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=900

# First admin account, created by `pnpm db:seed`
ADMIN_EMAIL=admin@nostos.pt
ADMIN_PASSWORD=change-me-please-123
ADMIN_NAME=Admin
