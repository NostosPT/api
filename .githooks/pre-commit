#!/usr/bin/env bash
set -e

# Prevent direct commits to main
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
if [ "$branch" = "main" ]; then
  echo "Error: Direct commits to 'main' are forbidden." >&2
  echo "Please switch to a feature or development branch before committing." >&2
  exit 1
fi
