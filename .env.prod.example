# Production settings for compose.prod.yml. Copy to .env.prod on the CT (never commit it).
# Generate secrets with `openssl rand -hex 32`. Use hex: these end up inside URLs and JSON.

# The CT's WireGuard address. API and S3 ports are published only on this IP.
BIND_ADDRESS=10.8.0.2

# The VPS's WireGuard address: Caddy's requests come from here, so the API trusts its
# X-Forwarded-For. Verify with deploy/README.md step 7.
TRUST_PROXY=10.8.0.1

# Public origins of the website (comma-separated, no trailing slash).
CORS_ORIGINS=https://nostos.pt,https://www.nostos.pt

# Public URL of the media host the proxy forwards to port 8333. Presigned image
# URLs point here.
S3_PUBLIC_ENDPOINT=https://media.nostos.pt

POSTGRES_PASSWORD=
COOKIE_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nostos

# First admin, created by the migrate job if it doesn't exist yet. Clear these after the first deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
