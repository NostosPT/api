# Production environment for compose.prod.yml. Lives on the server only, e.g.
# /opt/nostos/api/.env.prod (chmod 600) — never commit the real file.
# `deploy/init-env.sh <path>` creates it from this template with every
# CHANGE_ME secret generated.

# --- Network ------------------------------------------------------------------
# Address the API and the S3 gateway are published on: this server's WireGuard
# IP (the Caddy proxy connects over WireGuard). Never 0.0.0.0 — Docker
# published ports bypass host firewalls such as ufw.
BIND_ADDRESS=10.0.0.2
API_PORT=3000
STORAGE_PORT=8333

# Caddy proxy's WireGuard IP, so client IPs come from X-Forwarded-For
# (rate limiting, audit log). Comma-separate several addresses if needed.
TRUST_PROXY=10.0.0.1

# --- API ----------------------------------------------------------------------
# Frontend origin(s), comma-separated. Never "*" (cookies are credentialed).
CORS_ORIGINS=https://nostos.photos
COOKIE_SECRET=CHANGE_ME
LOG_LEVEL=
DOCS_ENABLED=false
SITE_COPYRIGHT=
SESSION_ABSOLUTE_SECONDS=
SESSION_IDLE_SECONDS=
SESSION_MAX_CONCURRENT=
UPLOAD_MAX_BYTES=

# --- Health monitoring + alert emails -----------------------------------------
# Monitoring runs by default in production (MONITOR_ENABLED=false turns it off).
# Public URL of this API through Caddy: watches reachability + TLS expiry, so
# a broken proxy, WireGuard link or certificate is noticed from this side.
MONITOR_PUBLIC_URL=https://api.nostos.photos
# true also watches S3_PUBLIC_ENDPOINT (browser uploads/downloads) + its TLS.
MONITOR_PUBLIC_STORAGE=true
HEALTH_RETENTION_DAYS=
# Resend (https://resend.com): alerts go to every ACTIVE ADMIN user. Use a
# sending-only key restricted to the verified domain. Empty disables emails.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Nostos Alerts <alerts@nostos.photos>
# Used only if no ADMIN list is cached yet (API started while PostgreSQL was down).
ALERT_FALLBACK_RECIPIENTS=
# Thresholds/intervals can be overridden too; names and defaults in .env.example.

# --- PostgreSQL ---------------------------------------------------------------
# Internal only (never published). Keep the password URL-safe (hex).
POSTGRES_DB=nostos
POSTGRES_USER=nostos
POSTGRES_PASSWORD=CHANGE_ME

# --- Photo storage (SeaweedFS, S3-compatible) -----------------------------------
# Public HTTPS URL of the S3 gateway through Caddy. Presigned upload/download
# URLs are signed for this host, so it must be what browsers reach.
S3_PUBLIC_ENDPOINT=https://storage.nostos.photos
# Origins allowed to use presigned URLs from the browser (usually = CORS_ORIGINS).
STORAGE_CORS_ORIGINS=https://nostos.photos
S3_BUCKET=nostos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- Off-site backups (any S3-compatible provider) ------------------------------
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=nostos-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# rclone S3 provider name (Other, AWS, Cloudflare, Wasabi, Minio, Ceph, ...).
BACKUP_S3_PROVIDER=Other
# Folder inside the backup bucket.
BACKUP_PREFIX=nostos
# Cron syntax, UTC.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
# Optional dead-man's switch (e.g. https://hc-ping.com/<uuid>); pinged on
# start, success, and /fail.
BACKUP_HEALTHCHECK_URL=
# Client-side encryption of everything off-site (rclone crypt). Generated by
# init-env.sh. Store both values in a password manager: without them the
# backups cannot be restored. Empty disables encryption.
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME
BACKUP_ENCRYPTION_SALT=CHANGE_ME
