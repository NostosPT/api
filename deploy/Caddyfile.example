# /etc/caddy/Caddyfile on the Oracle VPS. HTTPS certificates are automatic once the
# DNS records point here and ports 80/443 are open.
# 10.8.0.2 = the CT's WireGuard address (BIND_ADDRESS in .env.prod).
#
# Caddy already does what the API and storage need:
#   - keeps the original Host header (presigned URLs are signed for media.nostos.pt)
#   - streams request bodies without buffering or a size limit (large original uploads)
#   - replaces any client-sent X-Forwarded-For with the real client IP

{
	# Let's Encrypt account / expiry notices
	email you@nostos.pt
}

api.nostos.pt {
	encode zstd gzip
	reverse_proxy 10.8.0.2:4000
}

media.nostos.pt {
	reverse_proxy 10.8.0.2:8333
}
