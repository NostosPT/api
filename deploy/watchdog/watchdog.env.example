# Nostos API watchdog configuration (proxy VPS). Lives on the VPS only, e.g.
# /etc/nostos-watchdog.env (chmod 600, owned by root) — never commit the real file.

# Readiness URL through the public proxy. /v1/ready also fails when the API's
# database or storage is down, so those outages alert from here too.
WATCHDOG_URL=https://api.nostos.photos/v1/ready
WATCHDOG_TIMEOUT_SECONDS=10
# Consecutive failed checks (one per minute) before the DOWN email, and
# consecutive good checks before the RECOVERED email.
WATCHDOG_FAILURE_THRESHOLD=3
WATCHDOG_RECOVERY_THRESHOLD=2

# Resend. Prefer a separate sending-only key from the API's, so either can be
# revoked alone.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Nostos Watchdog <alerts@nostos.photos>
# Comma-separated. Static on purpose: the VPS cannot read the API's ADMIN list,
# and this list must work when the API is down.
ALERT_RECIPIENTS=
