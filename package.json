{
	"name": "typescript-webserver-template",
	"version": "1.0.0",
	"description": "TypeScript Web Server foundation built with Fastify, structured logging, and a modular architecture.",
	"main": "dist/index.js",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"argon2"
		]
	},
	"engines": {
		"node": "22.18.0",
		"pnpm": "10.15.0",
		"npm": "10.9.3"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ressiws/typescript-webserver-template.git"
	},
	"keywords": [
		"typescript",
		"nodejs",
		"fastify",
		"webserver",
		"rest-api",
		"backend",
		"webserver-template",
		"typescript-template"
	],
	"author": "Swisser",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ressiws/typescript-webserver-template/issues"
	},
	"homepage": "https://github.com/ressiws/typescript-webserver-template#readme",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1141.0",
		"@aws-sdk/s3-request-presigner": "^3.1141.0",
		"@fastify/compress": "9.2.0",
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "11.3.0",
		"@fastify/helmet": "13.1.1",
		"@fastify/rate-limit": "11.2.0",
		"@fastify/swagger": "9.8.1",
		"@fastify/swagger-ui": "6.1.1",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"argon2": "^0.45.1",
		"fastify": "5.12.1",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"typebox": "^1.3.34"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"eslint": "10.9.1",
		"prisma": "^7.10.0",
		"tsx": "4.23.12",
		"typescript": "5.9.3",
		"vitest": "^5.0.2"
	}
}